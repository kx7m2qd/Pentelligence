{
  "name": "pentelligence",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.11.0 <24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test server/**/*.test.js",
    "pentelligence": "node bin/pentelligence.mjs",
    "preview": "vite preview",
    "preserver": "npm rebuild better-sqlite3 --silent",
    "server": "nodemon --watch server server/index.js",
    "server:prod": "NODE_ENV=production node server/index.js",
    "start": "npm run server:prod",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "groq-sdk": "^1.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xml2js": "^0.6.2"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "vite": "^8.0.4"
  }
}
