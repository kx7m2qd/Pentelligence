# Server
PORT=3001
APP_PORT=3001
NODE_ENV=production

# Optional local access gate for deployments shared with other people.
# This secret never leaves the server and must be at least 16 characters when set.
APP_PASSWORD=
SESSION_TTL_HOURS=24

# Browser/API origins. For Docker single-port deployment, localhost:3001 is enough.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173

# Safety guardrail. Keep false unless you intentionally scan private/internal ranges.
ALLOW_PRIVATE_TARGETS=false
ENABLE_ACTIVE_EXPLOITATION=false
MAX_CONCURRENT_SCANS=2
DISCORD_WEBHOOK_URL=

# AI analysis
GROQ_API_KEY=

# Scanner paths and templates
NMAP_PATH=
NUCLEI_TEMPLATES_DIR=/home/node/nuclei-templates

# Docker build args. Use "latest" by default or pin exact versions for reproducible builds.
GO_VERSION=1.25-bookworm
NODE_VERSION=22-bookworm-slim
NUCLEI_VERSION=latest
SUBFINDER_VERSION=latest

# Frontend API base. Leave /api for Docker and local Vite proxy.
VITE_API_BASE_URL=/api
